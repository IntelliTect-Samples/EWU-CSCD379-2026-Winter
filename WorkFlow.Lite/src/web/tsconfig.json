{
  "extends": "./.nuxt/tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "types": ["vite/client", "node"],
    "jsx": "preserve",
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": [
    "nuxt.config.ts",
    "app/**/*.vue",
    "pages/**/*.vue",
    "layouts/**/*.vue",
    "middleware/**/*.ts",
    "plugins/**/*.ts",
    "composables/**/*.ts",
    "components/**/*.vue",
    "utils/**/*.ts",
    "server/**/*.ts",
    "**/*.d.ts",
    "**/*.ts",
    "**/*.vue",
    "**/*.d.ts"
  ]

}